# Copy to .env (or server/.env) for local use. On Railway these are entered as service Variables
# (the helper ./deploy-railway.sh does it for you). NEVER commit real values. NEVER put any in public/.

# --- Required on the host (names only; values are secret) ---
APP_PASSCODE=
TONEPERFECT_API_KEY=
OPENAI_API_KEY=

# --- Optional: Azure neural Mandarin TTS (preferred voice). Set BOTH or NEITHER. ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- Set on Railway (not secret) ---
# DATA_DIR: where coach.db lives. On Railway this is the volume mount path: /data.
# Locally leave it unset (defaults to ./data) or point it at a folder you keep.
DATA_DIR=/data
NODE_ENV=production

# PORT: do NOT set it on Railway; Railway injects it at run time and the server reads it
# (default 8080 when unset, e.g. local `npm start`).
# Other optional names (see server/ENV.md): SESSION_SECRET, SESSION_DAYS, TRUST_PROXY, ASSESSMENT_ENGINE.
